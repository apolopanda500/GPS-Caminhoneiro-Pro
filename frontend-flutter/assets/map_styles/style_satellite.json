{
  "version": 8,
  "name": "GPS Caminhoneiro - Satelite com Ruas",
  "sources": {
    "esri": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "Esri World Imagery"
    },
    "labels": {
      "type": "raster",
      "tiles": [
        "https://basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "© CARTO © OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0A0A0A" }
    },
    {
      "id": "esri-satellite",
      "type": "raster",
      "source": "esri",
      "paint": { "raster-fade-duration": 150 }
    },
    {
      "id": "street-labels",
      "type": "raster",
      "source": "labels",
      "paint": { "raster-opacity": 0.9, "raster-fade-duration": 200 }
    }
  ]
}

PORT=3000
DATABASE_URL=postgresql://postgres:senha@localhost:5432/gps_truck_pro
FRONTEND_URL=*
JWT_SECRET=troque-por-uma-string-aleatoria-segura
ADMIN_TOKEN=troque-por-um-token-admin-seguro

# Migracao de dados entre bancos (npm run migrate-data).
# No Supabase use sempre o POOLER (IPv4). O host direto e IPv6-only e
# falha em provedores IPv4 (Render) com ENOTFOUND.
# sslmode=require e recomendado: o backend remove o parametro da URL e
# aplica TLS sem validar a cadeia (o pooler usa certificado proprio).
SOURCE_DATABASE_URL=postgresql://usuario:senha@host-render-externo:5432/gps_truck_pro?sslmode=require
TARGET_DATABASE_URL=postgresql://postgres.PROJECT_REF:senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# PIX estatico (recebimento direto na conta do desenvolvedor)
PIX_KEY=sua-chave-pix
PIX_NAME=HENRIQUE DE CARVALHO
PIX_CITY=RIO DE JANEIRO
PIX_AMOUNT=4.99
PIX_DESCRIPTION=Assinatura Premium GPS Caminhoneiro Pro

# SMTP para codigos de confirmacao de conta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=GPS Caminhoneiro Pro <seu-email@gmail.com>

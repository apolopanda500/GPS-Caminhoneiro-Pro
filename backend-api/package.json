{
  "name": "gps-truck-backend",
  "version": "1.0.0",
  "description": "Servidor 24/7 em Tempo Real para o GPS Caminhoneiro Pro (Rede Veicular V2X)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "migrate": "node dist/scripts/migrate.js",
    "start": "node dist/scripts/migrate.js || true && node dist/server.js",
    "dev": "ts-node src/server.ts",
    "backup": "node dist/scripts/backup.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
